# Copy to `.env` next to ADBoard.exe (optional).
# Start-ADBoard.ps1 also applies sensible defaults; env vars win over this file
# only if you load them yourself (the exe reads process environment, not dotenv).

# Role on the Windows USB host is almost always controller.
ADBOARD_ROLE=controller

# Loopback = browser on this PC only. Use 0.0.0.0 when a remote LXC agent must connect.
ADBOARD_BIND=127.0.0.1
ADBOARD_PORT=3848

ADBOARD_HOST=windows-host
ADBOARD_HOST_ID=windows-host

# Paths relative to the pack folder work if you set them after cd'ing there.
# ADB_PATH=vendor\adb\adb.exe
# SCRCPY_PATH=vendor\scrcpy\scrcpy.exe
# SCRCPY_SERVER_PATH=vendor\scrcpy\scrcpy-server
# SCRCPY_EXTRA_ARGS=--max-size=1280

# Macros, scripts and settings live in %LOCALAPPDATA%\ADBoard. For a portable
# install (data next to ADBoard.exe) set:
# ADBOARD_DATA_DIR=C:\ADBoard\ADBoard-data
# Older PHONECONTROL_* names still work (with a warning in the log).

# Video: testpattern until scrcpy→WS is wired; auto prefers scrcpy when present.
ADBOARD_VIDEO_SOURCE=auto
# ADBOARD_FORCE_MOCK=1
# ADBOARD_MOCK_PROFILE=windows
# ADBOARD_AUTO_SESSION=1

# Remote access through Nginx Proxy Manager / Cloudflare: require sign-in.
# Without it, requests that arrive through a proxy are refused.
# Or open http://127.0.0.1:3848 on this PC and click "Set password".
# ADBOARD_PASSWORD=choose-a-long-passphrase   # first password; change it later in the UI
# ADBOARD_RESET_PASSWORD=1                     # replace a forgotten password

# Only if this Windows box is an *agent* registering with another controller:
# ADBOARD_ROLE=agent
# ADBOARD_CONTROLLER_URL=ws://192.168.1.10:3848/ws/agent
# ADBOARD_HTTP_BASE=http://192.168.1.20:3849
