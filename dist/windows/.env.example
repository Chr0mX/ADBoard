# Copy to `.env` next to RasielControl.exe (optional).
# Start-RasielControl.ps1 also applies sensible defaults; env vars win over this file
# only if you load them yourself (the exe reads process environment, not dotenv).

# Role on the Windows USB host is almost always controller.
PHONECONTROL_ROLE=controller

# Loopback = browser on this PC only. Use 0.0.0.0 when a remote LXC agent must connect.
PHONECONTROL_BIND=127.0.0.1
PHONECONTROL_PORT=3848

PHONECONTROL_HOST=windows-host
PHONECONTROL_HOST_ID=windows-host

# Paths relative to the pack folder work if you set them after cd'ing there.
# ADB_PATH=vendor\adb\adb.exe
# SCRCPY_PATH=vendor\scrcpy\scrcpy.exe
# SCRCPY_SERVER_PATH=vendor\scrcpy\scrcpy-server
# SCRCPY_EXTRA_ARGS=--max-size=1280

# Video: testpattern until scrcpy→WS is wired; auto prefers scrcpy when present.
PHONECONTROL_VIDEO_SOURCE=auto
# PHONECONTROL_FORCE_MOCK=1
# PHONECONTROL_MOCK_PROFILE=windows
# PHONECONTROL_AUTO_SESSION=1

# Remote access through Nginx Proxy Manager / Cloudflare: require sign-in.
# Without it, requests that arrive through a proxy are refused.
# PHONECONTROL_PASSWORD=choose-a-long-passphrase

# Only if this Windows box is an *agent* registering with another controller:
# PHONECONTROL_ROLE=agent
# PHONECONTROL_CONTROLLER_URL=ws://192.168.1.10:3848/ws/agent
# PHONECONTROL_HTTP_BASE=http://192.168.1.20:3849
