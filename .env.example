# Rust adboard-agent (default port 3848 = controller)
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:3848

# Optional agent / mesh overrides (export in the shell that runs cargo):
# ADBOARD_ROLE=controller          # or agent
# ADBOARD_BIND=127.0.0.1           # or 0.0.0.0 for LAN / remote agents
# ADBOARD_PORT=3848
# ADBOARD_HOST=windows-host
# ADBOARD_HOST_ID=windows-host
# ADBOARD_CONTROLLER_URL=ws://127.0.0.1:3848/ws/agent
# ADBOARD_HTTP_BASE=http://127.0.0.1:3849   # agent: reachable URL for video proxy
# ADBOARD_MOCK_PROFILE=windows     # all | windows | lxc
# ADBOARD_VIDEO_SOURCE=testpattern # auto | testpattern | scrcpy | off
# FFMPEG_PATH=/usr/bin/ffmpeg
# ADB_PATH=/usr/bin/adb
# SCRCPY_PATH=/usr/bin/scrcpy
# SCRCPY_SERVER_PATH=/usr/share/scrcpy/scrcpy-server
# SCRCPY_SERVER_VERSION=3.3.1           # optional; inferred from filename / scrcpy --version
# SCRCPY_MAX_SIZE=1280
# SCRCPY_SERVER_OPTS=max_fps=30
# SCRCPY_EXTRA_ARGS=--max-size=1280
# ADBOARD_SCRCPY_FIXTURE=1         # mock scrcpy backend without USB
# ADBOARD_FORCE_MOCK=1
# ADBOARD_AUTO_SESSION=1
# ADBOARD_DATA_DIR=/path/to/data          # default: %LOCALAPPDATA%\ADBoard (Windows), ~/.local/share/ADBoard (Linux); set for portable mode
# ADBOARD_TEMP=/path/to/temp              # default: <data folder>/temp
# ADBOARD_CONNECT_DISPLAY_SIZE=900x1600   # set every phone to this wm size when it comes online (reset on disconnect)
# Older PHONECONTROL_* names still work (with a warning in the log).
# Remote access (reverse proxy / Cloudflare): require sign-in in the browser.
# ADBOARD_PASSWORD=choose-a-long-passphrase   # first password only; change it later in the UI
# ADBOARD_USERNAME=admin
# ADBOARD_AUTH_FILE=./auth.json                 # default: <data folder>/config/auth.json
# ADBOARD_RESET_PASSWORD=1                     # replace a forgotten password with ADBOARD_PASSWORD
# ADBOARD_ALLOW_PROXY_WITHOUT_PASSWORD=1   # only if Cloudflare Access (or similar) guards the site
# ADBOARD_CONTROLLER_URL=wss://adboard.example.com/ws/agent   # agents can join over https too
