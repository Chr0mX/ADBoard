# Rust rasiel-agent (default port 3848 = controller)
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:3848

# Optional agent / mesh overrides (export in the shell that runs cargo):
# PHONECONTROL_ROLE=controller          # or agent
# PHONECONTROL_BIND=127.0.0.1           # or 0.0.0.0 for LAN / remote agents
# PHONECONTROL_PORT=3848
# PHONECONTROL_HOST=windows-host
# PHONECONTROL_HOST_ID=windows-host
# PHONECONTROL_CONTROLLER_URL=ws://127.0.0.1:3848/ws/agent
# PHONECONTROL_HTTP_BASE=http://127.0.0.1:3849   # agent: reachable URL for video proxy
# PHONECONTROL_MOCK_PROFILE=windows     # all | windows | lxc
# PHONECONTROL_VIDEO_SOURCE=testpattern # auto | testpattern | scrcpy | off
# FFMPEG_PATH=/usr/bin/ffmpeg
# ADB_PATH=/usr/bin/adb
# SCRCPY_PATH=/usr/bin/scrcpy
# SCRCPY_SERVER_PATH=/usr/share/scrcpy/scrcpy-server
# SCRCPY_SERVER_VERSION=3.3.1           # optional; inferred from filename / scrcpy --version
# SCRCPY_MAX_SIZE=1280
# SCRCPY_SERVER_OPTS=max_fps=30
# SCRCPY_EXTRA_ARGS=--max-size=1280
# PHONECONTROL_SCRCPY_FIXTURE=1         # mock scrcpy backend without USB
# PHONECONTROL_FORCE_MOCK=1
# PHONECONTROL_AUTO_SESSION=1
# Remote access (reverse proxy / Cloudflare): require sign-in in the browser.
# PHONECONTROL_PASSWORD=choose-a-long-passphrase   # first password only; change it later in the UI
# PHONECONTROL_USERNAME=admin
# PHONECONTROL_AUTH_FILE=./rasiel-auth.json         # default: next to the executable
# PHONECONTROL_RESET_PASSWORD=1                     # replace a forgotten password with PHONECONTROL_PASSWORD
# PHONECONTROL_ALLOW_PROXY_WITHOUT_PASSWORD=1   # only if Cloudflare Access (or similar) guards the site
# PHONECONTROL_CONTROLLER_URL=wss://rasiel.example.com/ws/agent   # agents can join over https too
