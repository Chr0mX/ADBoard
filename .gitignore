# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# agent host-file root (screenshots, uploads)
/data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rust
/target/
**/*.rs.bk

# Allow Windows pack env example (root .env* rule would otherwise hide it)
!dist/windows/.env.example

# Dependency fetch cache (make fetch-deps) — never commit downloads/extracts
/temp/

# Vendored ADB / scrcpy binaries (downloaded, not committed)
/tools/linux/adb/**
!/tools/linux/adb/README.md
!/tools/linux/adb/.gitkeep
/tools/linux/scrcpy/**
!/tools/linux/scrcpy/README.md
!/tools/linux/scrcpy/.gitkeep
/dist/windows/vendor/adb/**
!/dist/windows/vendor/adb/README.md
!/dist/windows/vendor/adb/.gitkeep
/dist/windows/vendor/scrcpy/**
!/dist/windows/vendor/scrcpy/README.md
!/dist/windows/vendor/scrcpy/.gitkeep
dist/windows/data/wireless-adb.json

# ADBoard sign-in account (password hash; rasiel-auth.json is the pre-rename name)
adboard-auth.json
adboard-auth.json.tmp
rasiel-auth.json
test-results/

# User data from before ADBoard kept it in %LOCALAPPDATA%\ADBoard (moved there
# on first start), and portable-mode data folders. Never commit or clean these.
adboard-data/
adboard-data/
/data/
/dist/windows/data/
site/guide/

# Default data folder beside ADBoard.exe (Windows pack) and in the repo for dev builds.
/adboard-data/
dist/windows/adboard-data/
# Data folder in the repository root (Windows pack, D:\GitHub\Phone-farm\ADBoard).
/ADBoard/
